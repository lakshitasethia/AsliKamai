# Bundled into the APK — only public values belong here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Local-dev fallback only (skips the proxy). Never ship a build with this set:
# anything in .env can be read out of the APK.
# GEMINI_API_KEY=your_key_here

# Cloud backup's Google sign-in: the *Web* OAuth client ID (public). Without it
# the Backup screen says backup isn't set up. See
# docs/superpowers/specs/2026-09-24-cloud-backup-design.md.
# GOOGLE_WEB_CLIENT_ID=1234-abc.apps.googleusercontent.com
