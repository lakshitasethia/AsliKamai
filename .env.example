# Bundled into the APK — only public values belong here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Local-dev fallback only (skips the proxy). Never ship a build with this set:
# anything in .env can be read out of the APK.
# GEMINI_API_KEY=your_key_here
